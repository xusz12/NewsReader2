# 从项目根目录执行：source docs/handoff/examples/runtime.env.example
# 此文件不会自动加载。实际部署请复制后改成接手方的绝对路径。
# 不要将 API key、CLI 认证或浏览器凭据写入本文件。
export NEWSREADER_DATA_ROOT="$PWD/output/handoff-demo"
export NEWS_READER_HOST=127.0.0.1
export NEWS_READER_PORT=8080
export NEWS_READER_DAILY_NEWS_DIR="$NEWSREADER_DATA_ROOT/daily"
export NEWS_READER_DAILY_BRIEFING_DIR="$NEWSREADER_DATA_ROOT/briefings"
export NEWS_READER_DB_PATH="$NEWSREADER_DATA_ROOT/news_index.sqlite3"
export NEWS_READER_APP_SETTINGS_PATH="$NEWSREADER_DATA_ROOT/app_settings.json"
export NEWS_READER_MEDIA_CACHE_DIR="$NEWSREADER_DATA_ROOT/media-cache"
export NEWS_READER_AGENT_DB_PATH="$NEWSREADER_DATA_ROOT/agent_sessions.sqlite3"
export NEWS_READER_AGENT_RUNTIME_DIR="$NEWSREADER_DATA_ROOT/runtime/agent"
export NEWS_READER_UPDATER_DIR="$NEWSREADER_DATA_ROOT/runtime/updater"
